{
  "id": "compact-time-tracker",
  "name": "Compact Time Tracker",
  "version": "1.0.3",
  "manifestVersion": 1,
  "minSupVersion": "19.3.0",
  "description": "Compact time tracking: search a task, start/stop, chronological list with corrections. timeSpentOnDay stays authoritative; from–to entries are stored with persistDataSynced.",
  "author": "JA",
  "hooks": [
    "action",
    "anyTaskUpdate",
    "currentTaskChange",
    "dayChange",
    "languageChange",
    "persistedDataChanged",
    "projectListUpdate"
  ],
  "permissions": [
    "addProject",
    "addTask",
    "dispatchAction",
    "getAllProjects",
    "getAppState",
    "getCurrentLanguage",
    "getDayContext",
    "getSecret",
    "getTasks",
    "listSyncedDataKeys",
    "loadSyncedData",
    "persistDataSynced",
    "setSecret",
    "showIndexHtmlAsView",
    "showSnack",
    "startTracking",
    "stopTracking",
    "translate",
    "updateTask"
  ],
  "dataSharing": [],
  "iFrame": true,
  "sidePanel": true,
  "icon": "icon.svg",
  "i18n": {
    "languages": [
      "en",
      "de"
    ]
  }
}
